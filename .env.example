# ==============================================================================
# Sign2Speech - Environment Template
# Salin file ini menjadi `.env` lalu masukkan credentials proyek Supabase Anda:
# cp .env.example .env
# ==============================================================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

MENU_PHOTOS_BUCKET=menu-photos
SIGN_VIDEOS_BUCKET=sign-videos
